# Pexip OTJ portal endpoints (server-side only, used by /api/meetings).
# These are Pexip's public published URLs and rarely need overriding.
PEXIP_OTJ_AUTH_URL=https://auth.otj.pexip.io
PEXIP_OTJ_API_URL=https://otj.pexip.io

# Provider detection domains -- used to recognize meeting aliases coming from
# the OTJ calendar so the right provider icon appears on each entry, and to
# build the Google Meet dial string for Quick Join.
NEXT_PUBLIC_GOOGLE_DOMAIN=
NEXT_PUBLIC_TEAMS_DOMAIN=
NEXT_PUBLIC_PEXIP_DOMAIN=

# Optional: pre-fill the Setup Wizard / Settings during local development.
# Copy this file to .env.local (gitignored) and fill in your test rig values.
# End users leave these blank and enter values via the in-app Settings modal.
NEXT_PUBLIC_DEFAULT_NODE_DOMAIN=
NEXT_PUBLIC_DEFAULT_DISPLAY_NAME=
NEXT_PUBLIC_DEFAULT_REG_ALIAS=
NEXT_PUBLIC_DEFAULT_REG_USERNAME=
NEXT_PUBLIC_DEFAULT_REG_PASSWORD=
NEXT_PUBLIC_DEFAULT_OTJ_CLIENT_ID=
NEXT_PUBLIC_DEFAULT_OTJ_CLIENT_SECRET=
NEXT_PUBLIC_DEFAULT_PEXIP_CUSTOMER_ID=
