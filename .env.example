# Pexip OTJ portal endpoints (server-side only, used by /api/meetings).
# These are Pexip's public published URLs and rarely need overriding.
PEXIP_OTJ_AUTH_URL=https://auth.otj.pexip.io
PEXIP_OTJ_API_URL=https://otj.pexip.io

# Provider detection domains -- used to recognize meeting aliases coming from
# the OTJ calendar so the right provider icon appears on each entry, and to
# build the Google Meet dial string for Quick Join.
NEXT_PUBLIC_GOOGLE_DOMAIN=
NEXT_PUBLIC_TEAMS_DOMAIN=
NEXT_PUBLIC_PEXIP_DOMAIN=
