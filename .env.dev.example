# Optional dev convenience. Copy this file to .env.dev.local (gitignored)
# and fill in your test rig values to pre-populate the Setup Wizard during
# `npm run dev`. These vars are dead-code-eliminated from production
# builds via the NODE_ENV guard in src/utils/devDefaults.ts and never
# reach the client bundle.

NEXT_PUBLIC_DEV_NODE_DOMAIN=
NEXT_PUBLIC_DEV_DISPLAY_NAME=
NEXT_PUBLIC_DEV_REG_ALIAS=
NEXT_PUBLIC_DEV_REG_USERNAME=
NEXT_PUBLIC_DEV_REG_PASSWORD=
NEXT_PUBLIC_DEV_OTJ_CLIENT_ID=
NEXT_PUBLIC_DEV_OTJ_CLIENT_SECRET=
NEXT_PUBLIC_DEV_PEXIP_CUSTOMER_ID=
NEXT_PUBLIC_DEV_GOOGLE_DOMAIN=
